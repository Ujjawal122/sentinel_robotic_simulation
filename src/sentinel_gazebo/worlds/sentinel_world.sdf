<?xml version="1.0" ?>
<sdf version="1.8">
  <world name="sentinel_world">
    <!-- Physics engine settings -->
    <physics name="1ms" type="ignored">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
    </physics>

    <!-- Required Gazebo Simulation Plugins -->
    <plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics"/>
    <plugin filename="gz-sim-user-commands-system" name="gz::sim::systems::UserCommands"/>
    <plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster"/>
    <plugin filename="gz-sim-sensors-system" name="gz::sim::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>
    <plugin filename="gz-sim-imu-system" name="gz::sim::systems::Imu"/>

    <!-- Sunlight -->
    <light type="directional" name="sun">
      <cast_shadows>true</cast_shadows>
      <pose>0 0 15 0 0 0</pose>
      <diffuse>0.8 0.8 0.8 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <attenuation>
        <range>1000</range>
        <constant>0.9</constant>
        <linear>0.01</linear>
        <quadratic>0.001</quadratic>
      </attenuation>
      <direction>-0.5 0.1 -0.9</direction>
    </light>

    <!-- Ground Plane -->
    <model name="ground_plane">
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>50 50</size>
            </plane>
          </geometry>
          <surface>
            <friction>
              <ode>
                <mu>1.0</mu>
                <mu2>1.0</mu2>
              </ode>
            </friction>
          </surface>
        </collision>
        <visual name="visual">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>50 50</size>
            </plane>
          </geometry>
          <material>
            <ambient>0.8 0.8 0.8 1</ambient>
            <diffuse>0.8 0.8 0.8 1</diffuse>
            <specular>0.8 0.8 0.8 1</specular>
          </material>
        </visual>
      </link>
    </model>

    <!-- ========================================== -->
    <!-- WAREHOUSE STRUCTURE & WALLS                -->
    <!-- ========================================== -->

    <!-- Outer Perimeter Walls (20m x 14m, height 2.5m) -->
    <model name="outer_walls">
      <static>true</static>
      <!-- North Wall -->
      <link name="north_wall">
        <pose>0 7 1.25 0 0 0</pose>
        <collision name="c">
          <geometry><box><size>20.4 0.2 2.5</size></box></geometry>
        </collision>
        <visual name="v">
          <geometry><box><size>20.4 0.2 2.5</size></box></geometry>
          <material><ambient>0.6 0.6 0.65 1</ambient><diffuse>0.6 0.6 0.65 1</diffuse></material>
        </visual>
      </link>
      <!-- South Wall -->
      <link name="south_wall">
        <pose>0 -7 1.25 0 0 0</pose>
        <collision name="c">
          <geometry><box><size>20.4 0.2 2.5</size></box></geometry>
        </collision>
        <visual name="v">
          <geometry><box><size>20.4 0.2 2.5</size></box></geometry>
          <material><ambient>0.6 0.6 0.65 1</ambient><diffuse>0.6 0.6 0.65 1</diffuse></material>
        </visual>
      </link>
      <!-- East Wall -->
      <link name="east_wall">
        <pose>10 0 1.25 0 0 0</pose>
        <collision name="c">
          <geometry><box><size>0.2 14 2.5</size></box></geometry>
        </collision>
        <visual name="v">
          <geometry><box><size>0.2 14 2.5</size></box></geometry>
          <material><ambient>0.6 0.6 0.65 1</ambient><diffuse>0.6 0.6 0.65 1</diffuse></material>
        </visual>
      </link>
      <!-- West Wall -->
      <link name="west_wall">
        <pose>-10 0 1.25 0 0 0</pose>
        <collision name="c">
          <geometry><box><size>0.2 14 2.5</size></box></geometry>
        </collision>
        <visual name="v">
          <geometry><box><size>0.2 14 2.5</size></box></geometry>
          <material><ambient>0.6 0.6 0.65 1</ambient><diffuse>0.6 0.6 0.65 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- Interior Room Partitions & Doorways -->
    <model name="interior_partitions">
      <static>true</static>
      <!-- Divider Wall North (Room A: Storage Bay) leaving 2.0m doorway at x=1.0 -->
      <link name="room_a_wall_left">
        <pose>5 2 1.25 0 0 0</pose>
        <collision name="c"><geometry><box><size>8 0.2 2.5</size></box></geometry></collision>
        <visual name="v">
          <geometry><box><size>8 0.2 2.5</size></box></geometry>
          <material><ambient>0.7 0.7 0.75 1</ambient><diffuse>0.7 0.7 0.75 1</diffuse></material>
        </visual>
      </link>

      <!-- Divider Wall South (Room B: Server/Equipment Room) with doorway -->
      <link name="room_b_wall">
        <pose>5 -2 1.25 0 0 0</pose>
        <collision name="c"><geometry><box><size>8 0.2 2.5</size></box></geometry></collision>
        <visual name="v">
          <geometry><box><size>8 0.2 2.5</size></box></geometry>
          <material><ambient>0.7 0.7 0.75 1</ambient><diffuse>0.7 0.7 0.75 1</diffuse></material>
        </visual>
      </link>

      <!-- Divider Wall West (Room C: Loading Bay) -->
      <link name="room_c_wall">
        <pose>-4 1.5 1.25 0 0 0</pose>
        <collision name="c"><geometry><box><size>0.2 7 2.5</size></box></geometry></collision>
        <visual name="v">
          <geometry><box><size>0.2 7 2.5</size></box></geometry>
          <material><ambient>0.7 0.7 0.75 1</ambient><diffuse>0.7 0.7 0.75 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- ========================================== -->
    <!-- INSPECTION TARGETS & CHECKPOINT OBJECTS    -->
    <!-- ========================================== -->

    <!-- Checkpoint A (Storage Room): Cargo Pallet & Storage Boxes -->
    <model name="checkpoint_a_cargo">
      <static>true</static>
      <pose>7.5 4.5 0.5 0 0 0</pose>
      <link name="box1">
        <pose>0 0 0 0 0 0</pose>
        <collision name="c"><geometry><box><size>1.2 1.2 1.0</size></box></geometry></collision>
        <visual name="v">
          <geometry><box><size>1.2 1.2 1.0</size></box></geometry>
          <material><ambient>0.8 0.5 0.2 1</ambient><diffuse>0.8 0.5 0.2 1</diffuse></material>
        </visual>
      </link>
      <link name="box2">
        <pose>0 1.2 0.3 0 0 0</pose>
        <collision name="c"><geometry><box><size>0.8 0.8 0.6</size></box></geometry></collision>
        <visual name="v">
          <geometry><box><size>0.8 0.8 0.6</size></box></geometry>
          <material><ambient>0.7 0.4 0.1 1</ambient><diffuse>0.7 0.4 0.1 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- Checkpoint B (Server Room): Equipment Cabinets -->
    <model name="checkpoint_b_equipment">
      <static>true</static>
      <pose>8.0 -4.5 1.0 0 0 0</pose>
      <link name="server_rack">
        <collision name="c"><geometry><box><size>0.8 2.0 2.0</size></box></geometry></collision>
        <visual name="v">
          <geometry><box><size>0.8 2.0 2.0</size></box></geometry>
          <material><ambient>0.1 0.1 0.1 1</ambient><diffuse>0.2 0.2 0.2 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- Checkpoint C (Loading Bay): Industrial Barrels -->
    <model name="checkpoint_c_barrels">
      <static>true</static>
      <pose>-7.5 4.5 0.5 0 0 0</pose>
      <link name="barrel_1">
        <pose>0 0 0 0 0 0</pose>
        <collision name="c"><geometry><cylinder><radius>0.35</radius><length>1.0</length></cylinder></geometry></collision>
        <visual name="v">
          <geometry><cylinder><radius>0.35</radius><length>1.0</length></cylinder></geometry>
          <material><ambient>0.1 0.4 0.8 1</ambient><diffuse>0.1 0.4 0.8 1</diffuse></material>
        </visual>
      </link>
      <link name="barrel_2">
        <pose>0.8 0 0 0 0 0</pose>
        <collision name="c"><geometry><cylinder><radius>0.35</radius><length>1.0</length></cylinder></geometry></collision>
        <visual name="v">
          <geometry><cylinder><radius>0.35</radius><length>1.0</length></cylinder></geometry>
          <material><ambient>0.1 0.4 0.8 1</ambient><diffuse>0.1 0.4 0.8 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- Base / Charging Dock Station at Origin (x=0, y=0) -->
    <model name="charging_dock_pad">
      <static>true</static>
      <pose>0 0 0.005 0 0 0</pose>
      <link name="pad">
        <visual name="v">
          <geometry><box><size>1.0 1.0 0.01</size></box></geometry>
          <material><ambient>0.1 0.8 0.2 1</ambient><diffuse>0.1 0.8 0.2 1</diffuse></material>
        </visual>
      </link>
    </model>

  </world>
</sdf>

