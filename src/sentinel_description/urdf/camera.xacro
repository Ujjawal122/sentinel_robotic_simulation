<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

  <xacro:include filename="inertial_macros.xacro"/>

  <xacro:property name="cam_x" value="0.03"/>
  <xacro:property name="cam_y" value="0.10"/>
  <xacro:property name="cam_z" value="0.03"/>
  <xacro:property name="cam_mass" value="0.08"/>

  <!-- Physical Camera Mount on the front bumper of the chassis -->
  <joint name="camera_joint" type="fixed">
    <parent link="chassis"/>
    <child link="camera_link"/>
    <origin xyz="0.22 0 0.10" rpy="0 0 0"/>
  </joint>

  <link name="camera_link">
    <visual>
      <geometry>
        <box size="${cam_x} ${cam_y} ${cam_z}"/>
      </geometry>
      <material name="sentinel_blue">
        <color rgba="0.1 0.3 0.8 1.0"/>
      </material>
    </visual>
    <collision>
      <geometry>
        <box size="${cam_x} ${cam_y} ${cam_z}"/>
      </geometry>
    </collision>
    <xacro:inertial_box mass="${cam_mass}" x="${cam_x}" y="${cam_y}" z="${cam_z}">
      <origin xyz="0 0 0" rpy="0 0 0"/>
    </xacro:inertial_box>
  </link>

  <!-- Optical Link: Follows standard ROS optical frame conventions (Z-forward, X-right, Y-down) -->
  <joint name="camera_optical_joint" type="fixed">
    <parent link="camera_link"/>
    <child link="camera_optical_link"/>
    <origin xyz="0 0 0" rpy="-${pi/2} 0 -${pi/2}"/>
  </joint>

  <link name="camera_optical_link"/>

  <!-- Gazebo RGB-D Camera Sensor Definition (Harmonic / Sim 8) -->
  <gazebo reference="camera_link">
    <sensor name="camera" type="rgbd_camera">
      <always_on>true</always_on>
      <visualize>true</visualize>
      <update_rate>15.0</update_rate>
      <topic>/camera</topic>
      <gz_frame_id>camera_optical_link</gz_frame_id>
      <camera>
        <horizontal_fov>1.2</horizontal_fov>
        <image>
          <width>640</width>
          <height>480</height>
          <format>R8G8B8</format>
        </image>
        <clip>
          <near>0.2</near>
          <far>8.0</far>
        </clip>
        <optical_frame_id>camera_optical_link</optical_frame_id>
      </camera>
    </sensor>
  </gazebo>

</robot>

